{
  "name": "local-orbit",
  "private": true,
  "version": "0.1.0",
  "description": "A scenic, local-first AI workspace for everyday tasks.",
  "author": "Orbit",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.mjs",
    "setup:models": "powershell -ExecutionPolicy Bypass -File .\\setup-models.ps1",
    "prepare:training": "python prepare_training_data.py",
    "eval:local": "python eval_orbit.py",
    "desktop": "electron .",
    "build:desktop": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.orbit.local",
    "productName": "Orbit",
    "asar": false,
    "files": [
      "dist/**/*",
      "electron-main.mjs",
      "server.mjs",
      "agents.mjs",
      "autonomous.mjs",
      "provider.mjs",
      "native_runtime.py",
      "data/**/*",
      "models/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
